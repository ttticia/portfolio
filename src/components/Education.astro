---
import { education } from '../data/resume';
---

<section class="section" id="education">
  <div class="container">
    <p class="eyebrow">What I studied</p>
    <h2 class="section-heading">Education</h2>
    <div class="edu-grid">
      {
        education.map((e) => (
          <div class="card">
            <p class="muted">
              {e.start} – {e.end}
            </p>
            <h3>{e.degree}</h3>
            <p class="subtitle">{e.field}</p>
            <p class="muted" style="margin: 0;">{e.school}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
