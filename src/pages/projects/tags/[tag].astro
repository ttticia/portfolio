---
import Layout from '../../../components/Layout.astro';
import ProjCard from '../../../components/ProjCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('projects', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

type Props = { tag: string };

const { tag } = Astro.props;
const posts = (await getCollection('projects', ({ data }) => !data.draft && data.tags.includes(tag))).sort(
  (a, b) => Date.parse(b.data.start) - Date.parse(a.data.start),
);
---

<Layout title={`#${tag}`} description={`Projects tagged #${tag}`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p class="muted">{posts.length} project{posts.length === 1 ? '' : 's'}</p>
      <div class="post-list" style="margin-top: 2rem;">
        {posts.map((p) => <ProjCard project={p} />)}
      </div>
    </div>
  </section>
</Layout>
