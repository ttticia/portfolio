---
import Layout from '../../components/Layout.astro';
import ProjCard from '../../components/ProjCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../data/site';

const allPosts = await getCollection('projects', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => Date.parse(b.data.start) - Date.parse(a.data.start));

const tags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
const counts = new Map<string, number>();
for (const p of allPosts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
---

<Layout title="Projects" description="List of projects I've worked on, with links to more information about each one.">
  <section class="section">
    <div class="container">
      <h1>Projects</h1>
      <p class="muted" style="max-width: 60ch;">
        Examples of some of the projects I've worked on. Click on the project card to view more information about it.
      </p>

      {tags.length > 0 && (
        <div class="tag-list" style="margin: 1.5rem 0 2.5rem;">
          {tags.map((t) => (
            <a class="tag" href={withBase(`/projects/tags/${t}/`)}>#{t} <span style="opacity: 0.6;">({counts.get(t)})</span></a>
          ))}
        </div>
      )}  

      <div class="post-list">
        {posts.map((p) => <ProjCard project={p} />)}
      </div>
    </div>
  </section>
</Layout>
