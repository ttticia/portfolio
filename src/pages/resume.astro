---
import Layout from '../components/Layout.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import { site, withBase } from '../data/site';
import { experience } from '../data/resume';

const current = experience[0];
const links = Object.values(site.socials).filter((s) => s.url.startsWith('http') || s.url.startsWith('mailto'));
---

<Layout
  title="Resume"
  image="/img/og.jpg"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Resume</p>
      <h1>{site.author.name}</h1>
      <p class="muted"> Singapore University of Engineering and Design, Engineering Porduct Development </p>
      <p class="muted" style="margin: 0 0 1.5rem;">
        {links.map((s) => (
          <>
            {' · '}
            <a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>
          </>
        ))}
        {' · '}
      </p>
    </div>
  </section>

  <Experience />

  <Education />

  <Skills />
</Layout>
